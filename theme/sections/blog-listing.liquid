{% comment %} Blog listing — renders a blog index with article cards {% endcomment %}

{%- assign style_mod = section.settings.style | default: 'warm' -%}
{%- paginate blog.articles by section.settings.articles_per_page -%}

<section class="blog-listing section-lg section-style section-style--{{ style_mod }}" data-header-theme="light">
  {% render 'section-style-bg', style: style_mod %}
  <div class="container section-style__content">
    <header class="blog-listing__header animate-on-scroll">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumbs__list">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li aria-current="page">{{ blog.title }}</li>
        </ol>
      </nav>
      <h1 class="blog-listing__title">{{ section.settings.heading | default: blog.title }}</h1>
      {%- if section.settings.description != blank -%}
        <p class="blog-listing__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </header>

    {%- if blog.articles_count > 0 -%}
      <div class="blog-listing__grid">
        {%- for article in blog.articles -%}
          <article class="blog-card animate-on-scroll stagger-{{ forloop.index | at_most: 6 }}">
            <a href="{{ article.url }}" class="blog-card__link">
              {%- if article.image -%}
                <div class="blog-card__media">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(max-width: 767px) 100vw, 33vw',
                      widths: '400, 600, 800',
                      alt: article.image.alt | default: article.title
                  }}
                </div>
              {%- endif -%}
              <div class="blog-card__body">
                <time class="blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%d %B %Y' }}
                </time>
                <h2 class="blog-card__title">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}
                  <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 160 }}</p>
                {%- else -%}
                  <p class="blog-card__excerpt">{{ article.content | strip_html | truncate: 160 }}</p>
                {%- endif -%}
                <span class="blog-card__cta">Read article</span>
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- else -%}
      <p class="blog-listing__empty">No articles published in this blog yet.</p>
    {%- endif -%}
  </div>
</section>

{%- endpaginate -%}

<style>
  .blog-listing__header {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .blog-listing .breadcrumbs__list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: 0.8125rem;
  }

  .blog-listing .breadcrumbs__list li:not(:last-child)::after {
    content: '›';
    margin-left: 0.5rem;
    color: var(--color-text-tertiary);
  }

  .blog-listing .breadcrumbs__list a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .blog-listing__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .blog-listing__description {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 60ch;
  }

  .blog-listing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .blog-card {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-background);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(18, 18, 18, 0.08);
  }

  .blog-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }

  .blog-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
  }

  .blog-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-card__body {
    padding: 1.25rem;
  }

  .blog-card__date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    margin-bottom: 0.5rem;
  }

  .blog-card__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .blog-card__excerpt {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .blog-card__cta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .blog-listing__empty {
    color: var(--color-text-secondary);
  }

  @media (max-width: 991px) {
    .blog-listing__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .blog-listing__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Blog Listing",
  "class": "blog-listing-section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Background style",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "warm", "label": "Warm gradient" }
      ],
      "default": "warm"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the blog title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ]
}
{% endschema %}
