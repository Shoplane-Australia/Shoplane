{% comment %} Process flow — horizontal steps with Material Icons {% endcomment %}

{%- liquid
  assign style_mod = section.settings.style | default: 'cream'
  assign step_blocks = section.blocks | where: 'type', 'step'
-%}

{%- if step_blocks.size > 0 -%}
{% render 'async-material-symbols' %}

<section
  id="process-flow-{{ section.id }}"
  class="process-flow section-style section-style--{{ style_mod }}"
  data-section-id="{{ section.id }}"
>
  {% render 'section-style-bg', style: style_mod %}
  <div class="container section-style__content">
    <header class="process-flow__header animate-on-scroll">
      {%- if section.settings.heading != blank -%}
        <h2 class="process-flow__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="process-flow__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <ol class="process-flow__steps">
      {%- for block in step_blocks -%}
        {%- liquid
          assign icon_name = block.settings.icon
          if block.settings.custom_icon != blank
            assign icon_name = block.settings.custom_icon | strip | replace: ' ', '_' | downcase
          endif
        -%}
        <li class="process-flow__step animate-on-scroll" {{ block.shopify_attributes }}>
          <div class="process-flow__icon-row">
            <div class="process-flow__icon" aria-hidden="true">
              <span class="material-symbols-outlined">{{ icon_name }}</span>
            </div>
            {%- unless forloop.last -%}
              <span class="process-flow__arrow" aria-hidden="true">
                <svg width="24" height="12" viewBox="0 0 24 12" fill="none">
                  <path d="M0 6h20M20 6l-5-4.5M20 6l-5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endunless -%}
          </div>

          <span class="process-flow__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>

          {%- if block.settings.title != blank -%}
            <h3 class="process-flow__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="process-flow__desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<style>
  #process-flow-{{ section.id }} {
    padding: var(--space-16, 4rem) 0;
  }

  #process-flow-{{ section.id }} .process-flow__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.75rem;
  }

  #process-flow-{{ section.id }} .process-flow__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0;
  }

  #process-flow-{{ section.id }} .process-flow__subheading {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  #process-flow-{{ section.id }} .process-flow__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat({{ step_blocks.size }}, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  #process-flow-{{ section.id }} .process-flow__step {
    min-width: 0;
  }

  #process-flow-{{ section.id }} .process-flow__icon-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  #process-flow-{{ section.id }} .process-flow__icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle, rgba(27, 77, 62, 0.08));
    color: var(--color-accent, #1B4D3E);
    flex-shrink: 0;
  }

  #process-flow-{{ section.id }} .process-flow__icon .material-symbols-outlined {
    font-size: 1.375rem;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    line-height: 1;
  }

  #process-flow-{{ section.id }} .process-flow__arrow {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border, #C8C4BC);
    min-width: 0;
  }

  #process-flow-{{ section.id }} .process-flow__arrow svg {
    width: 100%;
    max-width: 4.5rem;
    height: auto;
  }

  #process-flow-{{ section.id }} .process-flow__number {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary, var(--color-text-secondary));
    margin-bottom: 0.5rem;
  }

  #process-flow-{{ section.id }} .process-flow__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  #process-flow-{{ section.id }} .process-flow__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 26ch;
  }

  @media (max-width: 991px) {
    #process-flow-{{ section.id }} .process-flow__steps {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 28rem;
      margin: 0 auto;
    }

    #process-flow-{{ section.id }} .process-flow__arrow {
      display: none;
    }

    #process-flow-{{ section.id }} .process-flow__desc {
      max-width: none;
    }
  }
</style>
{%- endif -%}

