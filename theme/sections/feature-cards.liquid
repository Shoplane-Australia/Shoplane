{% comment %} Feature cards — Material Icons grid with theme-editor dropdown {% endcomment %}

{%- liquid
  assign style_mod = section.settings.style | default: 'cream'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign layout_setting = section.settings.desktop_layout | default: 'auto'
  assign grid_cols = layout_setting

  if layout_setting == 'auto'
    if feature_blocks.size > 6
      assign grid_cols = '4'
    else
      assign grid_cols = '6'
    endif
  endif
-%}

{%- if feature_blocks.size > 0 or request.design_mode -%}
{% render 'async-material-symbols' %}

<section
  id="feature-cards-{{ section.id }}"
  class="feature-cards section-style section-style--{{ style_mod }}"
  data-section-id="{{ section.id }}"
>
  {% render 'section-style-bg', style: style_mod %}
  <div class="container section-style__content">
    <header class="feature-cards__header animate-on-scroll">
      {%- if section.settings.heading != blank -%}
        <h2 class="feature-cards__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="feature-cards__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    {%- if feature_blocks.size == 0 and request.design_mode -%}
      <p class="feature-cards__empty">Add feature blocks to populate this section.</p>
    {%- endif -%}

    <div class="feature-cards__grid feature-cards__grid--{{ grid_cols }}">
      {%- for block in feature_blocks -%}
        {%- liquid
          assign icon_name = block.settings.icon
          if block.settings.custom_icon != blank
            assign icon_name = block.settings.custom_icon | strip | replace: ' ', '_' | downcase
          endif
        -%}
        <article class="feature-cards__card animate-on-scroll" {{ block.shopify_attributes }}>
          <div class="feature-cards__icon" aria-hidden="true">
            <span class="material-symbols-outlined">{{ icon_name }}</span>
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="feature-cards__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="feature-cards__desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #feature-cards-{{ section.id }} {
    padding: var(--space-16, 4rem) 0;
  }

  #feature-cards-{{ section.id }} .feature-cards__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  #feature-cards-{{ section.id }} .feature-cards__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0;
  }

  #feature-cards-{{ section.id }} .feature-cards__subheading {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  #feature-cards-{{ section.id }} .feature-cards__grid {
    display: grid;
    gap: 1rem;
    justify-items: stretch;
  }

  #feature-cards-{{ section.id }} .feature-cards__grid--6 {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  #feature-cards-{{ section.id }} .feature-cards__grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  #feature-cards-{{ section.id }} .feature-cards__card {
    background: #fff;
    border: 1px solid var(--color-border, #E2DFD8);
    border-radius: 12px;
    padding: 1.75rem 1.25rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
    box-shadow: 0 1px 2px rgba(18, 18, 18, 0.04);
  }

  #feature-cards-{{ section.id }} .feature-cards__icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle, rgba(27, 77, 62, 0.08));
    color: var(--color-accent, #1B4D3E);
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  #feature-cards-{{ section.id }} .feature-cards__icon .material-symbols-outlined {
    font-size: 1.375rem;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    line-height: 1;
  }

  #feature-cards-{{ section.id }} .feature-cards__title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  #feature-cards-{{ section.id }} .feature-cards__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 22ch;
  }

  @media (max-width: 1199px) {
    #feature-cards-{{ section.id }} .feature-cards__grid--6,
    #feature-cards-{{ section.id }} .feature-cards__grid--4 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 699px) {
    #feature-cards-{{ section.id }} .feature-cards__grid--6,
    #feature-cards-{{ section.id }} .feature-cards__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    #feature-cards-{{ section.id }} .feature-cards__card {
      padding: 1.35rem 0.85rem 1.15rem;
    }

    #feature-cards-{{ section.id }} .feature-cards__desc {
      max-width: none;
    }
  }

  #feature-cards-{{ section.id }} .feature-cards__empty {
    text-align: center;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
  }

  {% if request.design_mode %}
    #feature-cards-{{ section.id }} .animate-on-scroll {
      opacity: 1;
      transform: none;
    }
  {% endif %}
</style>
{%- endif -%}

