{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign style_mod = section.settings.style | default: 'warm'
-%}

<section
  id="store-pricing-{{ section.id }}"
  class="store-pricing-table section-lg section-style section-style--{{ style_mod }}"
  data-section-id="{{ section.id }}"
  data-section-type="store-pricing-table"
>
  {% render 'section-style-bg', style: style_mod %}
  <div class="container section-style__content">
    <header class="store-pricing-table__header animate-on-scroll">
      <h2 class="store-pricing-table__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="store-pricing-table__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="store-pricing-table__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tier' -%}
            {%- liquid
              assign tier_variant = nil
              for variant in product.variants
                if variant.title == block.settings.variant_name
                  assign tier_variant = variant
                  break
                endif
              endfor
              if tier_variant == nil and product.variants.size >= forloop.index
                assign tier_variant = product.variants[forloop.index0]
              endif

              assign is_featured = block.settings.featured
              assign features = block.settings.features | newline_to_br | split: '<br />'
            -%}

            <article
              class="store-pricing-table__card{% if is_featured %} store-pricing-table__card--featured{% endif %}{% unless request.design_mode %} animate-on-scroll stagger-{{ forloop.index }}{% endunless %}"
              {{ block.shopify_attributes }}
            >
              {%- if is_featured -%}
                <span class="store-pricing-table__badge">Most Popular</span>
              {%- endif -%}

              <div class="store-pricing-table__card-top">
                <h3 class="store-pricing-table__tier-name">
                  {{ block.settings.tier_name | default: tier_variant.title }}
                </h3>

                {%- if tier_variant -%}
                  <p class="store-pricing-table__price">
                    <span class="store-pricing-table__price-amount">{{ tier_variant.price | money_without_trailing_zeros }}</span>
                    <span class="store-pricing-table__price-period">/ one time</span>
                  </p>
                {%- endif -%}

                {%- if block.settings.tagline != blank -%}
                  <p class="store-pricing-table__tagline">{{ block.settings.tagline }}</p>
                {%- endif -%}

                {%- if block.settings.best_for != blank -%}
                  <p class="store-pricing-table__best-for">{{ block.settings.best_for }}</p>
                {%- endif -%}
              </div>

              <div class="store-pricing-table__card-body">
                {%- if block.settings.includes_label != blank -%}
                  <p class="store-pricing-table__includes-label">{{ block.settings.includes_label }}</p>
                {%- endif -%}

                {%- if block.settings.features != blank -%}
                  <ul class="store-pricing-table__features">
                    {%- for feature in features -%}
                      {%- assign feature_text = feature | strip_html | strip -%}
                      {%- if feature_text != blank -%}
                        <li>
                          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                            <circle cx="9" cy="9" r="9" fill="currentColor" opacity="0.12"/>
                            <path d="M5.5 9.25L7.75 11.5L12.5 6.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                          <span>{{ feature_text }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if tier_variant -%}
                  <button
                    type="button"
                    class="btn {% if is_featured %}btn-primary{% else %}btn-outline{% endif %} store-pricing-table__select"
                    data-variant-id="{{ tier_variant.id }}"
                    data-variant-price="{{ tier_variant.price | money }}"
                    data-variant-title="{{ tier_variant.title | escape }}"
                    {% unless tier_variant.available %}disabled{% endunless %}
                  >
                    {%- if tier_variant.available -%}
                      {{ section.settings.button_text | default: 'Select' }} {{ tier_variant.title }}
                    {%- else -%}
                      Sold out
                    {%- endif -%}
                  </button>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_trust_strip -%}
      <ul class="store-pricing-table__trust animate-on-scroll">
        {%- if section.settings.trust_1 != blank -%}
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <circle cx="9" cy="9" r="9" fill="currentColor" opacity="0.12"/>
              <path d="M5.5 9.25L7.75 11.5L12.5 6.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_1 }}
          </li>
        {%- endif -%}
        {%- if section.settings.trust_2 != blank -%}
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <circle cx="9" cy="9" r="9" fill="currentColor" opacity="0.12"/>
              <path d="M5.5 9.25L7.75 11.5L12.5 6.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_2 }}
          </li>
        {%- endif -%}
        {%- if section.settings.trust_3 != blank -%}
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <circle cx="9" cy="9" r="9" fill="currentColor" opacity="0.12"/>
              <path d="M5.5 9.25L7.75 11.5L12.5 6.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_3 }}
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  #store-pricing-{{ section.id }} {padding: clamp(3rem, 8vw, 5rem) 0;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text, #121212);
    margin: 0 0 0.75rem;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__description {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #3D3D3A);
    margin: 0;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-border, #E8E5DE);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(18, 18, 18, 0.04);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card--featured {
    border-color: var(--color-accent, #1B4D3E);
    box-shadow: 0 12px 32px rgba(27, 77, 62, 0.12);
    transform: translateY(-4px);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: #F2C94C;
    color: #121212;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card-top {
    padding: 1.35rem 1.15rem 1.15rem;
    background: #fff;
    border-bottom: 1px solid var(--color-border, #E8E5DE);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__card-top {
    background: var(--color-accent, #1B4D3E);
    border-bottom-color: transparent;
    padding-top: 1.75rem;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__tier-name {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.35rem;
    color: var(--color-text, #121212);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__tier-name,
  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__price,
  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__tagline,
  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__best-for {
    color: #fff;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0 0 0.85rem;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__price-amount {
    font-family: var(--font-mono, var(--font-heading));
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-text, #121212);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__price-period {
    font-size: 0.875rem;
    color: var(--color-text-tertiary, #7A7872);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__price-period {
    color: rgba(255, 255, 255, 0.75);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__tagline {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 0.35rem;
    color: var(--color-text, #121212);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__best-for {
    font-size: 0.8125rem;
    line-height: 1.45;
    margin: 0;
    color: var(--color-text-secondary, #3D3D3A);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card--featured .store-pricing-table__best-for {
    color: rgba(255, 255, 255, 0.82);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem;
    background: #fff;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__includes-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text, #121212);
    margin: 0 0 0.85rem;
    line-height: 1.4;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__features {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-secondary, #3D3D3A);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__features svg {
    flex-shrink: 0;
    margin-top: 0.05rem;
    color: var(--color-accent, #1B4D3E);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__select {
    width: 100%;
    margin-top: auto;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__trust {
    list-style: none;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2rem;
  }

  #store-pricing-{{ section.id }} .store-pricing-table__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary, #3D3D3A);
  }

  #store-pricing-{{ section.id }} .store-pricing-table__trust svg {
    color: var(--color-accent, #1B4D3E);
  }

  @media (max-width: 1100px) {
    #store-pricing-{{ section.id }} .store-pricing-table__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    #store-pricing-{{ section.id }} .store-pricing-table__card--featured {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    #store-pricing-{{ section.id }} .store-pricing-table__grid {
      grid-template-columns: 1fr;
    }
  }

  {% if request.design_mode %}
    #store-pricing-{{ section.id }} .animate-on-scroll {
      opacity: 1;
      transform: none;
    }
  {% endif %}
</style>

<script>
  (function() {
    var section = document.getElementById('store-pricing-{{ section.id }}');
    if (!section) return;

    var selectButtons = section.querySelectorAll('.store-pricing-table__select');
    var hiddenInput = document.getElementById('product-variant-id');
    var addBtn = document.querySelector('.add-to-cart-btn');
    var variantInputs = document.querySelectorAll('.variant-card__input');

    selectButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var variantId = this.dataset.variantId;
        var variantPrice = this.dataset.variantPrice;

        if (hiddenInput) hiddenInput.value = variantId;

        variantInputs.forEach(function(input) {
          input.checked = input.value === variantId;
          var card = input.closest('.variant-card');
          if (card) card.classList.toggle('variant-card--selected', input.checked);
        });

        if (addBtn) {
          addBtn.textContent = 'Add to Cart — ' + variantPrice;
          addBtn.disabled = false;
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  })();
</script>

