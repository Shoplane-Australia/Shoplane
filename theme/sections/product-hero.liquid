{% comment %} Shoplane Product Hero — store product page {% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%} Default package copy keyed by common variant titles {%- endcomment -%}
{%- capture package_defaults -%}
Foundation|Launch-ready store|Premium Theme|Essential Pages|Product Setup|Basic SEO Ready
Growth|Grow with content|Foundation Features|Blog Setup|Collection Setup|Email Setup
Pro|Optimise & convert|Growth Features|Speed Optimisation|App Integrations|Marketing Support
Scale|Scale with priority|Pro Features|Advanced SEO|Conversion Boost|Priority Support
{%- endcapture -%}
{%- assign default_rows = package_defaults | strip | newline_to_br | split: '<br />' -%}

<section class="product-hero section-lg" data-header-theme="light" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="description" content="{{ product.description | strip_html | truncate: 200 }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  {% if product.featured_image %}
    <meta itemprop="image" content="{{ product.featured_image | image_url: width: 1200 }}">
  {% endif %}
  <div itemprop="brand" itemscope itemtype="https://schema.org/Brand">
    <meta itemprop="name" content="{{ product.vendor | default: shop.name }}">
  </div>
  <div itemprop="offers" itemscope itemtype="https://schema.org/AggregateOffer">
    <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
    <meta itemprop="lowPrice" content="{{ product.price_min | money_without_trailing_zeros }}">
    <meta itemprop="highPrice" content="{{ product.price_max | money_without_trailing_zeros }}">
    <meta itemprop="offerCount" content="{{ product.variants.size }}">
    <link itemprop="availability" href="https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">
  </div>

  <div class="container">
    <nav class="breadcrumbs animate-on-scroll" aria-label="Breadcrumb">
      <ol class="breadcrumbs__list">
        <li><a href="/">Home</a></li>
        {% if product.collections.size > 0 %}
          <li><a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a></li>
        {% endif %}
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="product-hero__grid">
      <div class="product-hero__gallery animate-on-scroll">
        <div class="product-gallery">
          <div class="product-gallery__main" id="product-main-image">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w, {{ product.featured_image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 767px) 100vw, 48vw"
                alt="{% render 'auto-alt', title: product.title, image: product.featured_image %}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="eager"
                class="product-gallery__image"
                id="main-product-img"
              >
            {% else %}
              <div class="product-gallery__placeholder">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                  <path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            {% endif %}
          </div>

          {% if product.images.size > 1 %}
            <div class="product-gallery__thumbs" role="listbox" aria-label="Product image thumbnails">
              {% for image in product.images %}
                <button
                  class="product-gallery__thumb{% if forloop.first %} product-gallery__thumb--active{% endif %}"
                  role="option"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="View image {{ forloop.index }}"
                  data-image-src="{{ image | image_url: width: 900 }}"
                  data-image-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
                  data-image-alt="{% render 'auto-alt', title: product.title, image: image %}"
                >
                  <img
                    src="{{ image | image_url: width: 120 }}"
                    alt="{% render 'auto-alt', title: product.title, image: image %}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="product-hero__info animate-on-scroll">
        <h1 class="product-hero__title">{{ product.title }}</h1>

        <div class="product-hero__price">
          <span class="price-current" id="product-price-{{ section.id }}">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="price-compare" id="product-compare-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>

        {% if product.metafields.descriptors.subtitle %}
          <p class="product-hero__excerpt">{{ product.metafields.descriptors.subtitle.value }}</p>
        {% elsif product.description != blank %}
          <p class="product-hero__excerpt">{{ product.description | strip_html | truncate: 160 }}</p>
        {% endif %}

        {% if product.variants.size > 1 %}
          <div class="package-picker" id="package-picker-{{ section.id }}">
            <div class="package-picker__header">
              <h2 class="package-picker__heading">{{ section.settings.package_heading | default: 'Choose your package' }}</h2>
              <div class="package-picker__mini-trust">
                <span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Secure checkout
                </span>
                <span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  One-time payment
                </span>
              </div>
            </div>

            <div class="package-picker__grid" role="radiogroup" aria-label="Choose package">
              {% for variant in product.variants %}
                {%- liquid
                  assign pkg_subtitle = ''
                  assign pkg_features = ''
                  assign pkg_popular = false

                  for block in section.blocks
                    if block.type == 'package'
                      assign match_name = block.settings.variant_name | default: block.settings.tier_name | strip
                      if match_name == variant.title
                        assign pkg_subtitle = block.settings.subtitle
                        assign pkg_features = block.settings.features
                        assign pkg_popular = block.settings.popular
                        break
                      endif
                    endif
                  endfor

                  if pkg_subtitle == blank and pkg_features == blank
                    for row in default_rows
                      assign cols = row | strip | split: '|'
                      if cols[0] == variant.title
                        assign pkg_subtitle = cols[1]
                        assign pkg_features = cols[2] | append: '|' | append: cols[3] | append: '|' | append: cols[4] | append: '|' | append: cols[5]
                        break
                      endif
                    endfor
                  endif

                  if pkg_subtitle == blank and pkg_features == blank
                    assign row_index = forloop.index0
                    if default_rows[row_index]
                      assign cols = default_rows[row_index] | strip | split: '|'
                      assign pkg_subtitle = cols[1]
                      assign pkg_features = cols[2] | append: '|' | append: cols[3] | append: '|' | append: cols[4] | append: '|' | append: cols[5]
                    endif
                  endif

                  if pkg_popular == false and forloop.first
                    assign pkg_popular = true
                  endif

                  assign feature_list = pkg_features | newline_to_br | split: '<br />'
                  if pkg_features contains '|'
                    assign feature_list = pkg_features | split: '|'
                  endif
                -%}

                <label
                  class="package-card{% if variant == current_variant %} package-card--selected{% endif %}{% unless variant.available %} package-card--unavailable{% endunless %}"
                >
                  <input
                    type="radio"
                    name="package-picker-{{ section.id }}"
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                    class="package-card__input visually-hidden"
                    data-variant-id="{{ variant.id }}"
                    data-variant-price="{{ variant.price | money }}"
                    data-variant-title="{{ variant.title | escape }}"
                    data-variant-available="{{ variant.available }}"
                  >

                  {% if pkg_popular %}
                    <span class="package-card__badge">Most popular</span>
                  {% endif %}

                  <span class="package-card__check" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>

                  <span class="package-card__name">{{ variant.title }}</span>
                  {% if pkg_subtitle != blank %}
                    <span class="package-card__subtitle">{{ pkg_subtitle }}</span>
                  {% endif %}
                  <span class="package-card__price">{{ variant.price | money_without_trailing_zeros }}</span>

                  {% if feature_list.size > 0 %}
                    <ul class="package-card__features">
                      {% for feature in feature_list %}
                        {%- assign feature_text = feature | strip_html | strip -%}
                        {% if feature_text != blank %}
                          <li>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                              <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            {{ feature_text }}
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                </label>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="product-trust-grid">
          <div class="product-trust-grid__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <div>
              <strong>Australian Based</strong>
              <span>Local support</span>
            </div>
          </div>
          <div class="product-trust-grid__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div>
              <strong>Secure Checkout</strong>
              <span>Safe & encrypted</span>
            </div>
          </div>
          <div class="product-trust-grid__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.5"/></svg>
            <div>
              <strong>One-time Payment</strong>
              <span>No recurring fees</span>
            </div>
          </div>
          <div class="product-trust-grid__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" stroke="currentColor" stroke-width="1.5"/><path d="M8 12l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div>
              <strong>Money Back</strong>
              <span>7-day guarantee</span>
            </div>
          </div>
        </div>

        {% form 'product', product, id: 'product-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="product-variant-id">
          <div class="product-hero__actions">
            <button
              type="submit"
              class="btn btn-primary btn-lg add-to-cart-btn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {% if current_variant.available %}
                Add to Cart — {{ current_variant.price | money }}
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </div>
        {% endform %}

        <p class="product-hero__delivery">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M1 3h15v13H1zM16 8h4l3 4v4h-7V8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <circle cx="5.5" cy="18.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="18.5" cy="18.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Instant access after purchase
        </p>

        {% if product.metafields.custom.preview_url %}
          <a href="{{ product.metafields.custom.preview_url.value }}" target="_blank" rel="noopener noreferrer" class="preview-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <polyline points="15,3 21,3 21,9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Preview This Store
          </a>
        {% endif %}

        {% assign accordion_blocks = section.blocks | where: 'type', 'accordion' %}
        {% if accordion_blocks.size > 0 %}
          <div class="product-accordions">
            {% for block in accordion_blocks %}
              <details class="product-accordion" {{ block.shopify_attributes }}>
                <summary class="product-accordion__trigger">
                  {{ block.settings.heading }}
                  <svg class="accordion-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="product-accordion__content">
                  {{ block.settings.content }}
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .product-hero {
    padding: calc(var(--header-height, 72px) + 2rem) 0 4rem;
    background: var(--color-background, #FAFAF8);
  }

  .product-hero .breadcrumbs__list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  .product-hero .breadcrumbs__list li:not(:last-child)::after {
    content: '›';
    margin-left: 0.5rem;
    color: var(--color-text-tertiary);
  }

  .product-hero .breadcrumbs__list a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .product-hero .breadcrumbs__list a:hover {
    color: var(--color-accent);
  }

  .product-hero .breadcrumbs__list [aria-current] {
    color: var(--color-text);
    font-weight: 500;
  }

  .product-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .product-gallery__main {
    overflow: hidden;
    background: var(--color-surface);
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
  }

  .product-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: transparent;
  }

  .product-gallery__placeholder {
    color: var(--color-text-tertiary);
  }

  .product-gallery__thumbs {
    display: flex;
    gap: 0.625rem;
    margin-top: 0.875rem;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .product-gallery__thumb {
    width: 72px;
    height: 72px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    opacity: 0.55;
    transition: border-color 0.2s, opacity 0.2s;
  }

  .product-gallery__thumb--active {
    border-color: var(--color-accent);
    opacity: 1;
  }

  .product-gallery__thumb:hover { opacity: 1; }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.65rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .product-hero__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .price-current {
    font-family: var(--font-mono);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .price-compare {
    font-size: 1rem;
    color: var(--color-text-tertiary);
    text-decoration: line-through;
  }

  .product-hero__excerpt {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1.35rem;
  }

  /* Package picker cards */
  .package-picker {
    margin-bottom: 1.25rem;
  }

  .package-picker__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .package-picker__heading {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .package-picker__mini-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .package-picker__mini-trust span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .package-picker__mini-trust svg {
    color: var(--color-accent);
  }

  .package-picker__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .package-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 0.75rem 0.85rem;
    background: #fff;
    border: 1.5px solid var(--color-border, #E8E5DE);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
    min-height: 100%;
  }

  .package-card:hover:not(.package-card--unavailable) {
    border-color: rgba(27, 77, 62, 0.45);
  }

  .package-card--selected {
    border-color: var(--color-accent, #1B4D3E);
    box-shadow: 0 0 0 1px var(--color-accent, #1B4D3E);
  }

  .package-card--unavailable {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .package-card__badge {
    position: absolute;
    top: -0.55rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-accent, #1B4D3E);
    color: #fff;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .package-card__check {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--color-accent, #1B4D3E);
    color: #fff;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .package-card--selected .package-card__check {
    display: inline-flex;
  }

  .package-card__name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .package-card__subtitle {
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
    line-height: 1.3;
  }

  .package-card__price {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent, #1B4D3E);
    font-variant-numeric: tabular-nums;
    margin: 0.15rem 0 0.25rem;
  }

  .package-card__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .package-card__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.3rem;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .package-card__features svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-accent, #1B4D3E);
  }

  .product-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.15rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .product-trust-grid__item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .product-trust-grid__item svg {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 0.1rem;
  }

  .product-trust-grid__item strong {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
  }

  .product-trust-grid__item span {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
    line-height: 1.3;
  }

  .product-hero__actions {
    margin-bottom: 0.75rem;
  }

  .add-to-cart-btn {
    width: 100%;
  }

  .product-hero__delivery {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .product-hero__delivery svg {
    color: var(--color-accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0,0,0,0);
    border: 0;
  }

  .preview-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .preview-link:hover {
    text-decoration: underline;
  }

  .product-accordions {
    border-top: 1px solid var(--color-border);
    margin-top: 0.5rem;
  }

  .product-accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .product-accordion__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.975rem;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .product-accordion__trigger::-webkit-details-marker { display: none; }
  .product-accordion__trigger::marker { display: none; content: ''; }

  .accordion-icon {
    transition: transform 0.3s;
    flex-shrink: 0;
  }

  .product-accordion[open] .accordion-icon {
    transform: rotate(180deg);
  }

  .product-accordion__content {
    padding: 0 0 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 1100px) {
    .package-picker__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .product-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .package-picker__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .package-picker__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    var thumbs = document.querySelectorAll('.product-gallery__thumb');
    var mainImg = document.getElementById('main-product-img');
    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        thumbs.forEach(function(t) {
          t.classList.remove('product-gallery__thumb--active');
          t.setAttribute('aria-selected', 'false');
        });
        this.classList.add('product-gallery__thumb--active');
        this.setAttribute('aria-selected', 'true');
        if (mainImg) {
          mainImg.src = this.dataset.imageSrc;
          mainImg.srcset = this.dataset.imageSrcset;
          mainImg.alt = this.dataset.imageAlt;
        }
      });
    });

    var picker = document.getElementById('package-picker-{{ section.id }}');
    var hiddenInput = document.getElementById('product-variant-id');
    var addBtn = document.querySelector('.add-to-cart-btn');
    var priceEl = document.getElementById('product-price-{{ section.id }}');

    function selectPackage(input) {
      if (!input || input.disabled) return;
      if (picker) {
        picker.querySelectorAll('.package-card').forEach(function(card) {
          card.classList.remove('package-card--selected');
        });
        var card = input.closest('.package-card');
        if (card) card.classList.add('package-card--selected');
      }
      if (hiddenInput) hiddenInput.value = input.dataset.variantId || input.value;
      if (priceEl) priceEl.textContent = input.dataset.variantPrice;
      if (addBtn) {
        var available = input.dataset.variantAvailable !== 'false';
        addBtn.disabled = !available;
        addBtn.textContent = available
          ? 'Add to Cart — ' + input.dataset.variantPrice
          : 'Sold Out';
      }
    }

    if (picker) {
      picker.querySelectorAll('.package-card__input').forEach(function(input) {
        input.addEventListener('change', function() {
          selectPackage(this);
        });
      });
    }
  })();
</script>

