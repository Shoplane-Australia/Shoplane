{% comment %} Important info — two-column panel with Material Icons and fact lists {% endcomment %}

{%- liquid
  assign style_mod = section.settings.style | default: 'light'
  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign left_count = 0
  assign right_count = 0

  for block in fact_blocks
    if block.settings.column == 'right'
      assign right_count = right_count | plus: 1
    else
      assign left_count = left_count | plus: 1
    endif
  endfor

  assign left_icon = section.settings.left_icon | default: 'groups'
  if section.settings.left_custom_icon != blank
    assign left_icon = section.settings.left_custom_icon | strip | replace: ' ', '_' | downcase
  endif

  assign right_icon = section.settings.right_icon | default: 'info'
  if section.settings.right_custom_icon != blank
    assign right_icon = section.settings.right_custom_icon | strip | replace: ' ', '_' | downcase
  endif

  assign bullet_icon = section.settings.bullet_icon | default: 'check'
  if section.settings.bullet_custom_icon != blank
    assign bullet_icon = section.settings.bullet_custom_icon | strip | replace: ' ', '_' | downcase
  endif
-%}

{%- if fact_blocks.size > 0 or request.design_mode -%}
{% render 'async-material-symbols' %}

<section
  id="important-info-{{ section.id }}"
  class="important-info section-style section-style--{{ style_mod }}"
  data-section-id="{{ section.id }}"
>
  {% render 'section-style-bg', style: style_mod %}
  <div class="container section-style__content">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="important-info__header animate-on-scroll">
        {%- if section.settings.heading != blank -%}
          <h2 class="important-info__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="important-info__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="important-info__panel animate-on-scroll">
      <div class="important-info__col">
        <div class="important-info__col-head">
          <span class="important-info__col-icon" aria-hidden="true">
            <span class="material-symbols-outlined">{{ left_icon }}</span>
          </span>
          {%- if section.settings.left_heading != blank -%}
            <h3 class="important-info__col-title">{{ section.settings.left_heading }}</h3>
          {%- endif -%}
        </div>

        {%- if left_count == 0 and request.design_mode -%}
          <p class="important-info__empty">Add fact blocks set to Left column.</p>
        {%- else -%}
          <ul class="important-info__list">
            {%- for block in fact_blocks -%}
              {%- if block.settings.column != 'right' and block.settings.text != blank -%}
                <li class="important-info__item" {{ block.shopify_attributes }}>
                  <span class="important-info__check" aria-hidden="true">
                    <span class="material-symbols-outlined">{{ bullet_icon }}</span>
                  </span>
                  <span class="important-info__text">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="important-info__divider" aria-hidden="true"></div>

      <div class="important-info__col">
        <div class="important-info__col-head">
          <span class="important-info__col-icon" aria-hidden="true">
            <span class="material-symbols-outlined">{{ right_icon }}</span>
          </span>
          {%- if section.settings.right_heading != blank -%}
            <h3 class="important-info__col-title">{{ section.settings.right_heading }}</h3>
          {%- endif -%}
        </div>

        {%- if right_count == 0 and request.design_mode -%}
          <p class="important-info__empty">Add fact blocks set to Right column.</p>
        {%- else -%}
          <ul class="important-info__list">
            {%- for block in fact_blocks -%}
              {%- if block.settings.column == 'right' and block.settings.text != blank -%}
                <li class="important-info__item" {{ block.shopify_attributes }}>
                  <span class="important-info__check" aria-hidden="true">
                    <span class="material-symbols-outlined">{{ bullet_icon }}</span>
                  </span>
                  <span class="important-info__text">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #important-info-{{ section.id }} {
    padding: var(--space-16, 4rem) 0;
  }

  #important-info-{{ section.id }} .important-info__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2rem;
  }

  #important-info-{{ section.id }} .important-info__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0;
  }

  #important-info-{{ section.id }} .important-info__subheading {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  #important-info-{{ section.id }} .important-info__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
    background: #f7f6f2;
    border-radius: 14px;
    padding: 2.5rem 2.75rem;
  }

  #important-info-{{ section.id }} .important-info__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  #important-info-{{ section.id }} .important-info__col:first-child {
    padding-right: 2.5rem;
  }

  #important-info-{{ section.id }} .important-info__col:last-child {
    padding-left: 2.5rem;
  }

  #important-info-{{ section.id }} .important-info__divider {
    width: 1px;
    align-self: stretch;
    background: var(--color-border, #E2DFD8);
  }

  #important-info-{{ section.id }} .important-info__col-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
  }

  #important-info-{{ section.id }} .important-info__col-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent, #1B4D3E);
    flex-shrink: 0;
    line-height: 1;
  }

  #important-info-{{ section.id }} .important-info__col-icon .material-symbols-outlined {
    font-size: 1.35rem;
    font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24;
    line-height: 1;
  }

  #important-info-{{ section.id }} .important-info__col-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text, #121212);
    margin: 0;
    line-height: 1.3;
  }

  #important-info-{{ section.id }} .important-info__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  #important-info-{{ section.id }} .important-info__item {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
  }

  #important-info-{{ section.id }} .important-info__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent, #1B4D3E);
    margin-top: 0.1rem;
    line-height: 1;
  }

  #important-info-{{ section.id }} .important-info__check .material-symbols-outlined {
    font-size: 1.125rem;
    font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 20;
    line-height: 1;
  }

  #important-info-{{ section.id }} .important-info__text {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-secondary, #3D3D3A);
  }

  #important-info-{{ section.id }} .important-info__empty {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 749px) {
    #important-info-{{ section.id }} .important-info__panel {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.35rem;
      gap: 0;
    }

    #important-info-{{ section.id }} .important-info__col:first-child,
    #important-info-{{ section.id }} .important-info__col:last-child {
      padding: 0;
    }

    #important-info-{{ section.id }} .important-info__divider {
      width: 100%;
      height: 1px;
      margin: 1.75rem 0;
    }
  }

  {% if request.design_mode %}
    #important-info-{{ section.id }} .animate-on-scroll {
      opacity: 1;
      transform: none;
    }
  {% endif %}
</style>
{%- endif -%}

