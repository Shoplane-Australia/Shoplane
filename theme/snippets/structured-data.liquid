{%- comment -%}JSON-LD Structured Data for SEO{%- endcomment -%}

{%- liquid
  assign business_name = settings.seo_business_name | default: shop.name
  assign business_email = settings.seo_email | default: 'hello@shoplane.com.au'
  assign business_description = shop.description | default: 'Ready-made Shopify stores and ecommerce services for Australian entrepreneurs.' | strip_html

  assign social_urls = ''
  if settings.social_facebook != blank
    assign social_urls = social_urls | append: settings.social_facebook | remove: '?' | append: '|'
  endif
  if settings.social_twitter != blank
    assign social_urls = social_urls | append: settings.social_twitter | remove: '?' | append: '|'
  endif
  if settings.social_instagram != blank
    assign social_urls = social_urls | append: settings.social_instagram | remove: '?' | append: '|'
  endif
  if settings.social_linkedin != blank
    assign social_urls = social_urls | append: settings.social_linkedin | remove: '?' | append: '|'
  endif
  if settings.social_youtube != blank
    assign social_urls = social_urls | append: settings.social_youtube | remove: '?' | append: '|'
  endif
  if settings.social_tiktok != blank
    assign social_urls = social_urls | append: settings.social_tiktok | remove: '?' | append: '|'
  endif
  assign same_as_array = social_urls | split: '|'
-%}

{%- if template == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ business_name | json }},
  "url": {{ shop.url | json }},
  "description": {{ business_description | truncate: 300 | json }},
  "email": {{ business_email | json }},
  {%- if settings.og_image_default -%}
  "logo": {{ settings.og_image_default | image_url: width: 512 | json }},
  "image": {{ settings.og_image_default | image_url: width: 1200 | json }},
  {%- endif -%}
  {%- if settings.seo_phone != blank -%}
  "telephone": {{ settings.seo_phone | json }},
  {%- endif -%}
  "address": {
    "@type": "PostalAddress",
    "addressLocality": {{ settings.seo_address_locality | json }},
    "addressRegion": {{ settings.seo_address_region | json }},
    "addressCountry": {{ settings.seo_address_country | json }}
  },
  {%- if same_as_array.size > 0 -%}
  "sameAs": [
    {%- assign first_same_as = true -%}
    {%- for url in same_as_array -%}
      {%- if url != blank -%}
        {%- unless first_same_as -%},{%- endunless -%}
        {{ url | json }}
        {%- assign first_same_as = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ settings.seo_business_type | default: 'ProfessionalService' }}",
  "name": {{ business_name | json }},
  "url": {{ shop.url | json }},
  "description": {{ business_description | truncate: 300 | json }},
  "email": {{ business_email | json }},
  {%- if settings.og_image_default -%}
  "image": {{ settings.og_image_default | image_url: width: 1200 | json }},
  {%- endif -%}
  {%- if settings.seo_phone != blank -%}
  "telephone": {{ settings.seo_phone | json }},
  {%- endif -%}
  "address": {
    "@type": "PostalAddress",
    "addressLocality": {{ settings.seo_address_locality | json }},
    "addressRegion": {{ settings.seo_address_region | json }},
    "addressCountry": {{ settings.seo_address_country | json }}
  },
  "priceRange": "$$",
  {%- if same_as_array.size > 0 -%}
  "sameAs": [
    {%- assign first_same_as = true -%}
    {%- for url in same_as_array -%}
      {%- if url != blank -%}
        {%- unless first_same_as -%},{%- endunless -%}
        {{ url | json }}
        {%- assign first_same_as = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Shopify Stores & Services",
    "itemListElement": [
      {
        "@type": "OfferCatalog",
        "name": "Ready-Made Shopify Stores",
        "description": "Professionally built, ready-to-launch Shopify dropshipping stores across multiple niches"
      },
      {
        "@type": "OfferCatalog",
        "name": "Ecommerce Services",
        "description": "Professional Shopify services including store setup, SEO, branding, and ongoing support"
      }
    ]
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ business_name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ shop.url | append: '/search?q={search_term_string}' | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- if template.name == 'product' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "url": {{ canonical_url | json }},
  {%- if product.featured_image -%}
  "image": {{ product.featured_image | image_url: width: 1200 | json }},
  {%- endif -%}
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ business_name | json }}
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ shop.currency | json }},
    "lowPrice": {{ product.price_min | money_without_currency | remove: ',' | json }},
    "highPrice": {{ product.price_max | money_without_currency | remove: ',' | json }},
    "offerCount": {{ product.variants.size | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": {{ business_name | json }}
    }
  },
  "category": {{ product.type | json }}
}
</script>
{%- endif -%}

{%- if template.name == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | truncate: 300 | json }},
  "url": {{ canonical_url | json }},
  "numberOfItems": {{ collection.products_count }},
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products limit: 10 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ shop.url | append: product.url | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endif -%}

{%- if template.name == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt | default: article.content | strip_html | truncate: 300 | json }},
  "url": {{ canonical_url | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  {%- if article.image -%}
  "image": {{ article.image | image_url: width: 1200 | json }},
  {%- endif -%}
  "author": {
    "@type": "Organization",
    "name": {{ business_name | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ business_name | json }}{%- if settings.og_image_default -%},
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.og_image_default | image_url: width: 512 | json }}
    }
    {%- endif -%}
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonical_url | json }}
  }
}
</script>
{%- endif -%}

{%- if template.name == 'blog' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ blog.title | json }},
  "description": {{ blog.metafields.global.description | default: blog.title | json }},
  "url": {{ canonical_url | json }},
  "publisher": {
    "@type": "Organization",
    "name": {{ business_name | json }}
  }
}
</script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {%- if template.name == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
    {%- if template.name == 'product' -%}
    {%- if product.collections.size > 0 -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.collections.first.title | json }},
      "item": {{ shop.url | append: product.collections.first.url | json }}
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
    {%- endif -%}
    {%- if template.name == 'page' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ page.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
    {%- if template.name == 'blog' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
    {%- if template.name == 'article' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ shop.url | append: blog.url | json }}
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
  ]
}
</script>
